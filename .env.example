# Copy to .env and supply values securely. Never commit the resulting file.
POSTGRES_DB=cards
POSTGRES_USER=cards
POSTGRES_PASSWORD=
# URL-encode password characters. Use postgres inside Compose, 127.0.0.1 for a local DB.
DATABASE_URL=postgresql://cards:CHANGE_ME@postgres:5432/cards
OPENROUTER_API_KEY=
EXTRACTION_MODEL=openai/gpt-6-luna
# Optional: pin a measured OpenRouter provider. No fallback chain is used.
EXTRACTION_PROVIDER=
MAX_RUN_COST_USD=4.5
# The shared run cap cannot exceed $4.99.
BROWSER_RENDERING=false
# Recommended production mode: verified Cloudflare Access JWTs and an explicit admin allowlist.
ADMIN_AUTH_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ADMIN_EMAILS=
# Alternative standard HTTP Basic auth, served only over HTTPS in production.
# ADMIN_AUTH_MODE=basic
ADMIN_USER=
ADMIN_PASSWORD=
# A dedicated disposable database is required for destructive integration tests.
TEST_DATABASE_URL=
